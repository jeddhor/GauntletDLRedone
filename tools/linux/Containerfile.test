# Older-distribution runtime check (M21; tools/python/old_distro_check.py):
# Ubuntu 20.04 (GNU C library 2.31, GCC 10's libstdc++) with only what a
# desktop provides and the Linux package leaves to the system — X11 and
# xcb client libraries, fontconfig/FreeType and a font, D-Bus, ALSA, udev
# — and the release's own Mesa Vulkan drivers. No development packages.
#
#   podman build -t gdl-runtime-focal:1 -f tools/linux/Containerfile.test tools/linux
FROM docker.io/library/ubuntu:20.04@sha256:c664f8f86ed5a386b0a340d981b8f81714e21a8b9c73f658c4bea56aa179d54a
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
        libfontconfig1 libfreetype6 fonts-dejavu-core libdbus-1-3 \
        libx11-6 libx11-xcb1 libxcb1 libxkbcommon-x11-0 libxcursor1 libxrandr2 libxi6 \
        libasound2 libudev1 libvulkan1 mesa-vulkan-drivers \
    && rm -rf /var/lib/apt/lists/* \
    && dpkg-query -W -f '${Package} ${Version}\n' > /runtime-environment.txt
